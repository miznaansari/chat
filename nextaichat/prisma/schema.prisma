generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

model User {
  id                String           @id @default(cuid())
  name              String           @unique
  password          String
  createdAt         DateTime         @default(now())
  hasChosenLanguage Boolean          @default(false)
  language          String           @default("en")
  authProvider      String           @default("credentials")
  email             String?          @unique
  emailVerified     Boolean          @default(false)
  dailyLimit        Int              @default(100)
  aiUsages          AiUsage[]
  characters        ChatCharacter[]
  chats             ChatSession[]
  snippets          ReusablePhrase[]
  UserPersona       UserPersona[]
  sessions          UserSession[]
}

model UserSession {
  id        String   @id @default(cuid())
  userId    String
  token     String   @db.Text
  isExpire  Boolean  @default(false)
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, isExpire])
}

model ChatCharacter {
  id          String   @id @default(cuid())
  userId      String
  name        String
  description String   @db.Text
  avatar      String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model ChatSession {
  id                 String             @id @default(cuid())
  userId             String
  title              String
  selectedModel      String             @default("gemini-3.5-flash-lite")
  createdAt          DateTime           @default(now())
  updatedAt          DateTime           @updatedAt
  story              String             @default("Interactive Roleplay Scenario") @db.Text
  userPersonaDetails String?            @db.Text
  userPersonaId      String?
  userPersonaName    String?
  discoverCharacterId String?
  discoverCharacter   DiscoverCharacter? @relation(fields: [discoverCharacterId], references: [id], onDelete: SetNull)
  messages           ChatMessage[]
  user               User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  UserPersona        UserPersona?       @relation(fields: [userPersonaId], references: [id], onDelete: SetNull)
  sessionCharacters  SessionCharacter[]

  @@index([userId, updatedAt])
  @@index([userId])
  @@index([userId, discoverCharacterId])
  @@index([userPersonaId], map: "ChatSession_userPersonaId_fkey")
}

model SessionCharacter {
  id            String      @id @default(cuid())
  chatSessionId String
  name          String
  persona       String      @db.Text
  createdAt     DateTime    @default(now())
  chatSession   ChatSession @relation(fields: [chatSessionId], references: [id], onDelete: Cascade)

  @@index([chatSessionId, createdAt])
  @@index([chatSessionId])
}

model ChatMessage {
  id               String      @id @default(cuid())
  chatSessionId    String
  role             String
  content          String      @db.Text
  includeInContext Boolean     @default(true)
  tokenEstimate    Int         @default(0)
  createdAt        DateTime    @default(now())
  chatSession      ChatSession @relation(fields: [chatSessionId], references: [id], onDelete: Cascade)

  @@index([chatSessionId, includeInContext, createdAt])
  @@index([chatSessionId, createdAt])
}

model ReusablePhrase {
  id        String   @id @default(cuid())
  userId    String
  text      String   @db.Text
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
}

model ContactSubmission {
  id        String   @id @default(cuid())
  userId    String?
  name      String
  email     String
  category  String   @default("General")
  message   String   @db.Text
  status    String   @default("sent")
  createdAt DateTime @default(now())

  @@index([createdAt])
}

model BlogPost {
  id         String   @id @default(cuid())
  title      String
  slug       String   @unique
  excerpt    String   @db.Text
  content    String   @db.Text
  coverImage String?  @db.Text
  category   String   @default("General")
  author     String   @default("NextAiChat Team")
  views      Int      @default(0)
  published  Boolean  @default(true)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([published, createdAt])
}

model AiUsage {
  id        String   @id @default(cuid())
  userId    String
  date      String
  count     Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, date])
  @@index([userId, date])
}

model Admin {
  id        String         @id @default(cuid())
  email     String         @unique
  password  String
  createdAt DateTime       @default(now())
  sessions  AdminSession[]
}

model AdminSession {
  id        String   @id @default(cuid())
  adminId   String
  token     String   @db.Text
  isExpire  Boolean  @default(false)
  createdAt DateTime @default(now())
  admin     Admin    @relation(fields: [adminId], references: [id], onDelete: Cascade)

  @@index([adminId, isExpire])
}

model DiscoverCharacter {
  id          String   @id @default(cuid())
  name        String
  tagline     String
  badge       String?
  badgeBg     String?
  avatar      String   @db.Text
  category    String   @default("Your Sales")
  filterGroup String   @default("assistants")
  chatsCount  Int      @default(0)
  rating      String   @default("4.9")
  story       String   @db.Text
  characters  String   @db.LongText
  isPublic    Boolean  @default(true)
  chatSessions ChatSession[]
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([isPublic, category])
}

model SystemMetric {
  id           String   @id @default(cuid())
  minuteBucket String   @unique
  requestCount Int      @default(0)
  queuedCount  Int      @default(0)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @default(now()) @updatedAt

  @@index([createdAt])
}

model UserPersona {
  id          String        @id
  userId      String
  name        String
  persona     String        @db.Text
  avatar      String?
  isDefault   Boolean       @default(false)
  createdAt   DateTime      @default(now())
  updatedAt   DateTime
  ChatSession ChatSession[]
  User        User          @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}
